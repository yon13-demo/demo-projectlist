generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  sessions  Session[]
}

model Project {
  id        String   @id @default(uuid())
  name      String
  sessions  Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  clockIn   DateTime @default(now())
  clockOut  DateTime?
  user      User     @relation(fields: [userId], references: [id])
  project   Project  @relation(fields: [projectId], references: [id])
}